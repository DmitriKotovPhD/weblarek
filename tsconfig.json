{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, 
    "paths": {
      "@/*": ["./src/*"] // Псевдоним @/* означает «любой файл в проекте под src»
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,       // Disable error when a variable "is declared but never read" 
    "noUnusedParameters": false,   // Disable error when a variable "is declared but never read" 
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

  },
  "include": ["src"]
}
